# Imagem base Python oficial
FROM python:3.11-slim

# Instala ffmpeg e libopus (necessários para áudio do Discord)
RUN apt-get update && \
    apt-get install -y --no-install-recommends ffmpeg libopus0 && \
    rm -rf /var/lib/apt/lists/*

# Define diretório de trabalho
WORKDIR /app

# Copia requirements primeiro para aproveitar cache do Docker
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copia todo o código do projeto
COPY . .

# Cria pasta para o banco de dados
RUN mkdir -p data

# Expõe a porta que o Render espera
EXPOSE 8080

# Comando de inicialização
CMD ["gunicorn", "main:app", "--bind", "0.0.0.0:8080", "--workers", "1"]